# Removing the "_T1" to each column name to match with the IDs
colnames(TPM_T1) <- sub("_T1$", "", colnames(TPM_T1))
colnames(TPM_T2) <- sub("_T2$", "", colnames(TPM_T2))

P4HA1_T1 <- as.numeric(TPM_T1["P4HA1", ])
P4HA1_T2 <- as.numeric(TPM_T2["P4HA1", ])
P4HA1_combined <- c(P4HA1_T1, P4HA1_T2)

threshold <- quantile(P4HA1_combined, 0.5, na.rm = TRUE)

# Replace Patient ID to SRC ID in clinical outcome table
clinical$Patient <- src_lookup[clinical$Patient]

# Removing the excluded patients : NA in both sarcoma immune class and sarcoma ecotype assignment
clinical_filtered <- clinical %>%
 dplyr::filter(!(`Sarcoma Immune Class`=="NA" & `Sarcoma Ecotype Assignment`=="NA"))


# Extract T1 patients for KM analysis

# Combine with patient IDs
P4HA1_expression_T1 <- data.frame(
  Patient = colnames(TPM_T1),
  TPM = P4HA1_T1
)

# Assigning  High or Low using the combined median
P4HA1_expression_T1$Group <- ifelse(P4HA1_expression_T1$TPM > threshold, "High", "Low")

# Combine with clinical data

df <- merge(clinical_filtered, P4HA1_expression_T1, by = "Patient")

df$Group <- paste(df$Group, df$`Treatment Arm`, sep = "_")

groups <- c("Low_Control", "High_Control", "Low_Experimental", "High_Experimental")

output <- lapply(groups, function(g) subset(df, Group==g)[, c("DFS Time (Days)","DFS Event")])
names(output) <- groups

# Export for Prism
write.table(output$Low_Control, "Low_Control.txt", sep="\t", row.names=FALSE)
write.table(output$High_Control, "High_Control.txt", sep="\t", row.names=FALSE)
write.table(output$Low_Experimental, "Low_Experimental.txt", sep="\t", row.names=FALSE)
write.table(output$High_Experimental, "High_Experimental.txt", sep="\t", row.names=FALSE)



